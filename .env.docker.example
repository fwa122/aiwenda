# ============================================================
# AI 知识库问答系统 · Docker 全栈部署环境变量
# 用法：cp .env.docker.example .env，然后填写所有必填项
# 生成强密钥：openssl rand -hex 32（Windows 可用 Git Bash 执行）
# ⚠️ .env 含密钥，已被 .gitignore 排除，切勿提交仓库
# ============================================================

# ── 必填：数据库 ──────────────────────────────
POSTGRES_USER=kb
POSTGRES_PASSWORD=change-me-to-strong-password
POSTGRES_DB=kb

# ── 必填：JWT 签名密钥（≥32 字符，否则 server 拒绝启动）──
JWT_SECRET=

# ── 必填：Redis 访问密码（redis 服务 fail-fast，未配置拒绝启动）──
# 生成强密码：openssl rand -hex 24
REDIS_PASSWORD=

# ── 必填：首次播种 admin 账号的初始密码（仅种子阶段使用，登录后请修改）──
ADMIN_INITIAL_PASSWORD=

# ── 必填：内部令牌（server 与 ai-service 共用；未配置时内部接口 fail-closed 返回 503）──
INTERNAL_TOKEN=

# ── 必填：MinIO 对象存储（原始文档存放处；生成强密码：openssl rand -hex 24）──
MINIO_ROOT_USER=kb-minio
MINIO_ROOT_PASSWORD=
# 桶名（一般保持默认，server 启动时自动创建）
MINIO_BUCKET=kb-documents

# ── 必填：智谱 BigModel（生成 + 向量 + rerank + OCR）──
ZHIPU_API_KEY=

# ── 可选：Moonshot Kimi（不填则仅可用 glm-* 模型）──
MOONSHOT_API_KEY=

# ── 可选：Qianwen / DashScope（生成 + 向量渠道；.env 示例即当前线上配置）──
QIANWEN_API_KEY=
QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 可选：嵌入渠道（换渠道/模型需全库重嵌入一次，缓存 key 含 provider/model 自动区分）──
EMBEDDING_PROVIDER=zhipu
EMBEDDING_MODEL=embedding-3

# ── 可选：其余保持默认即可 ─────────────────────
# 对外 HTTP 端口（80 被占用时改，如 8080）
NGINX_PORT=80
# JWT 有效期
JWT_EXPIRES_IN=120m
# CORS 白名单（同源部署下浏览器不经 CORS，填正式访问地址即可）
FRONTEND_URL=http://localhost
# 默认生成模型（可被会话级模型选择覆盖）：glm-4-flash / kimi-k2.6
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.3
# 轻量任务模型（查询改写/后续建议/会话命名）：留空跟随 LLM_MODEL 所在渠道；
# 可显式指定省成本型号（如 qwen3.7-flash，需配对应渠道 API Key）
FLASH_MODEL=
# Kimi 思考模式（disabled 保证流式无前置空白）
MOONSHOT_THINKING=disabled
# 扫描件 OCR 兜底
OCR_ENABLED=true
OCR_MAX_PAGES=20
